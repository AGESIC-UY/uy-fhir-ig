  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"es-UY\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"es-UY\"><p><b>Hoja de Consulta No Urgente</b> — documento final, 07/10/2026 10:31 (UTC-03:00). Confidencialidad: normal.</p><p>Paciente: María Laura González Pereira, CI 45000001. Profesional: Martín Andrés Rodríguez Silva (medicina general). Institución: Administración de los Servicios de Salud del Estado (ASSE).</p><p>Motivo de consulta: palpitaciones. Diagnóstico: hipertensión arterial (confirmado). Procedimientos: electrocardiograma (resultado normal) y medición de presión arterial, 158/96 mmHg (resultado anormal). Indicaciones: dieta hiposódica; enalapril 10 mg, 1 comprimido vía oral cada 12 horas durante 30 días. Control: 06/11/2026.</p></div>"^^rdf:XMLLiteral ]
  ] ; # 

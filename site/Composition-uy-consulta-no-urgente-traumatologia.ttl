  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"es-UY\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"es-UY\"><div class=\"uy-clinical-doc\"><div class=\"uy-clinical-doc__header\"><p class=\"uy-clinical-doc__title\">Hoja de Consulta No Urgente</p><p class=\"uy-clinical-doc__subtitle\">Documento final — 23/08/2019 11:05 (UTC-03:00) — Administración de los Servicios de Salud del Estado (ASSE)</p></div><div class=\"uy-clinical-doc__section uy-clinical-doc__section--patient\"><h4 class=\"uy-clinical-doc__section-title\">Datos del paciente</h4><dl class=\"uy-clinical-doc__fields\"><dt>Nombre</dt><dd>María Laura González Pereira</dd><dt>Cédula de identidad</dt><dd>45000001</dd><dt>Identificador (MRN ficticio FHIR)</dt><dd>1873455</dd><dt>Sexo administrativo</dt><dd>Femenino</dd><dt>Fecha de nacimiento</dt><dd>14/03/1987</dd></dl></div><div class=\"uy-clinical-doc__section uy-clinical-doc__section--encounter\"><h4 class=\"uy-clinical-doc__section-title\">Datos de la consulta</h4><dl class=\"uy-clinical-doc__fields\"><dt>Profesional</dt><dd>Guillermo Sousa</dd><dt>Institución</dt><dd>Administración de los Servicios de Salud del Estado (ASSE)</dd><dt>Servicio</dt><dd>Policlínica de traumatología (consulta ambulatoria)</dd><dt>Fecha y hora</dt><dd>23/08/2019, 10:05 a 10:15</dd><dt>Confidencialidad</dt><dd>Normal</dd></dl></div><div class=\"uy-clinical-doc__section\"><h4 class=\"uy-clinical-doc__section-title\">Motivos de consulta</h4><p>Mialgia.</p></div><div class=\"uy-clinical-doc__section\"><h4 class=\"uy-clinical-doc__section-title\">Diagnósticos</h4><p>Desgarro muscular. Fecha de inicio: 22/08/2016. Estado: problema no resuelto. Grado de certeza: confirmado.</p></div><div class=\"uy-clinical-doc__section\"><h4 class=\"uy-clinical-doc__section-title\">Procedimientos</h4><p>Vendaje de extremidad superior. Resultado: normal. Observaciones: paciente sedado durante el procedimiento.</p></div><div class=\"uy-clinical-doc__section\"><h4 class=\"uy-clinical-doc__section-title\">Tratamiento no farmacológico realizado</h4><p>Indicación/recomendación: administración de oxígeno.</p></div><div class=\"uy-clinical-doc__section\"><h4 class=\"uy-clinical-doc__section-title\">Tratamiento farmacológico realizado</h4><p>Paracetamol 650 mg comprimido. Se administra 1 comprimido.</p></div><div class=\"uy-clinical-doc__section\"><h4 class=\"uy-clinical-doc__section-title\">Tratamiento no farmacológico indicado al alta</h4><p>Hacer reposo durante las próximas 2 semanas.</p></div><div class=\"uy-clinical-doc__section\"><h4 class=\"uy-clinical-doc__section-title\">Tratamiento farmacológico indicado al alta</h4><p>1 comprimido de paracetamol 650 mg, vía oral, cada 8 horas durante 5 días, tomar con alimentos. Suspender en caso de alguna reacción adversa.</p></div><div class=\"uy-clinical-doc__section uy-clinical-doc__section--followup\"><h4 class=\"uy-clinical-doc__section-title\">Instrucciones de seguimiento</h4><p>Próximo control: 02/09/2019 (revisión a los 10 días). Referencia al alta: consulta de atención primaria.</p></div></div></div>"^^rdf:XMLLiteral ]
  ] ; # 

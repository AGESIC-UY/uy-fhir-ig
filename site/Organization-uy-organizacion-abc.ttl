     fhir:div [ fhir:v "<div xml:lang=\"es-UY\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"es-UY\"><p><b>Organización ABC</b></p><p>Identificador de la institución: urn:oid:2.16.858.0.0.2.1234.</p><p>Dirección: Av. Luis Alberto de Herrera 1234, MONTEVIDEO, Montevideo, URY.</p><p>Teléfono: +598 2486 5008.</p></div>"^^rdf:XMLLiteral ]
